.env
.hermes/
__pycache__/
*.py[cod]

# Runtime research may include real world saves/backups or server secrets; keep raw
# runtime snapshots local unless intentionally sanitized and committed.
research/**/*.db
research/**/*.db-*
research/**/*.sqlite
research/**/*.sqlite3
research/runtime-configs/2026-*-saved/
research/runtime-configs/2026-*-windowsserver/
research/runtime-configs/2026-*-analysis.md
research/runtime-configs/analyze-runtime-configs.py

# Compose migration/backup state may contain rollback archives, world data, or server metadata.
.conan-migration/
.conan-backups/

# Generated diagnostic reports are private-by-default operational artifacts.
conan-doctor-*.json
