FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

LABEL org.opencontainers.image.title="Conan Exiles Enhanced Dedicated Server — Native Linux Recommended"
LABEL org.opencontainers.image.description="Native Linux recommended for new servers and every new installation"
LABEL org.opencontainers.image.source="https://github.com/balnaimi/conan-exiles-server"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL com.balnaimi.conan.runtime="native-linux"
LABEL com.balnaimi.conan.support-tier="recommended"
LABEL com.balnaimi.conan.installation-track="new-servers"
LABEL com.balnaimi.conan.default="false"
LABEL com.balnaimi.conan.architecture="linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    GAME_DIR=/data/server \
    STEAM_DATA_DIR=/data/steam \
    BACKUP_DIR=/data/backups \
    STEAMCMD_BIN=/data/steam/steamcmd/steamcmd.sh \
    HOME=/data/steam

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        gzip \
        lib32gcc-s1 \
        libgcc-s1 \
        libstdc++6 \
        procps \
        python3 \
        sqlite3 \
        tar \
        tini \
        tzdata \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 conan \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/conan --shell /bin/bash conan \
    && mkdir -p /opt/steamcmd-bootstrap /data/server/ConanSandbox/Saved /data/steam /data/backups /scripts/native /scripts/runtime \
    && curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz \
       | tar -xz -C /opt/steamcmd-bootstrap \
    && chown -R conan:conan /data /home/conan

COPY scripts/native/ /scripts/native/
COPY scripts/runtime/ /scripts/runtime/
RUN chmod 0755 /scripts/native/*.sh /scripts/native/*.py 2>/dev/null || true \
    && chmod 0755 /scripts/runtime/*.sh

EXPOSE 7777/udp 7778/udp 27015/udp 25575/tcp
VOLUME ["/data/server", "/data/steam", "/data/backups"]

USER conan:conan
WORKDIR /data/server

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD ["/scripts/native/healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/scripts/native/entrypoint.sh"]
