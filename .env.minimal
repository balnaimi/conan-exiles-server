# Conan Exiles Enhanced Dedicated Server - minimal quick start
# Recommended for new servers: Native Linux (docker-compose.native.yml / :native).
# Existing Wine deployments remain compatible with docker-compose.yml / :latest.
# Native and Wine always use separate volumes.
# Copy or download this file as .env for a simple server using mostly defaults.

# Server name shown in the server browser
SERVER_NAME=My Conan Server

# Game mode: pve, pvp, or pve-c
SERVER_TYPE=pve

# Max players allowed at the same time
MAX_PLAYERS=10

# In-game admin password. Change this before opening a public server.
ADMIN_PASSWORD=changeme

# Join password. Leave empty for a public server.
SERVER_PASSWORD=

# Region: 0=EU, 1=NA, 2=Asia, 3=Oceania, 4=SA, 5=Japan
SERVER_REGION=0

# Timezone examples: UTC, Europe/London, Asia/Qatar, America/New_York
TZ=UTC
